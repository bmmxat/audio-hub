{
  "productName": "Audio Hub",
  "version": "0.2.0",
  "identifier": "com.audiohub.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Audio Hub",
        "width": 900,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
